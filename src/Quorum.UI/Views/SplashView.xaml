<UserControl x:Class="Quorum.UI.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BgMicaBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Placeholder Geometric Quorum Logo -->
            <Border Width="76"
                    Height="76"
                    CornerRadius="18"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">
                <Path Data="M12 3a9 9 0 1 0 6.36 15.36L21 21M12 7a5 5 0 1 0 3.54 8.54"
                      Stroke="{DynamicResource TextOnAccentBrush}"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Width="38"
                      Height="38"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Quorum"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Course Registration System"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,22" />

            <ProgressBar Width="180"
                         Height="4"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Background="{DynamicResource BgSubtleBrush}"
                         BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>
