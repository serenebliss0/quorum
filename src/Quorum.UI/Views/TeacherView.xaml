<UserControl x:Class="Quorum.UI.Views.TeacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Quorum.UI.Services">
    <UserControl.Resources>
        <svc:StatusPillBrushConverter x:Key="PillBgConverter" IsForeground="False" />
        <svc:StatusPillBrushConverter x:Key="PillFgConverter" IsForeground="True" />
    </UserControl.Resources>

    <Grid Margin="0,0,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Collapsible Navigation Rail -->
        <Grid Grid.Column="0" Margin="10,6,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button Style="{StaticResource NavItemButtonStyle}"
                        Margin="0,0,0,6"
                        ToolTipService.InitialShowDelay="800"
                        ToolTip="Collapse or expand navigation menu"
                        Click="OnToggleNavClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M3 6h18M3 12h18M3 18h18"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" Margin="4,0,0,0" />
                        <TextBlock x:Name="CollapseNavLabel" Text="Menu"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CoursesNavBtn"
                        Style="{StaticResource NavItemButtonStyle}"
                        Background="{DynamicResource BgSurfaceBrush}"
                        Margin="0,0,0,4"
                        ToolTipService.InitialShowDelay="800"
                        ToolTip="View My Courses"
                        Click="OnSelectCoursesNav">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CoursesIndicator" Width="3" Height="16" CornerRadius="2"
                                Background="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0" />
                        <Path Data="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                              Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.6"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="CoursesNavLabel" Text="My Courses"
                                   Style="{StaticResource BodyStrongTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CreateNavBtn"
                        Style="{StaticResource NavItemButtonStyle}"
                        Margin="0,0,0,4"
                        ToolTipService.InitialShowDelay="800"
                        ToolTip="Create Course"
                        Click="OnSelectCreateNav">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CreateIndicator" Width="3" Height="16" CornerRadius="2"
                                Background="Transparent" Margin="0,0,10,0" />
                        <Path Data="M12 5v14M5 12h14"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="CreateNavLabel" Text="Create Course"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="EnrolmentsNavBtn"
                        Style="{StaticResource NavItemButtonStyle}"
                        ToolTipService.InitialShowDelay="800"
                        ToolTip="View Enrolled Students"
                        Click="OnSelectEnrolmentsNav">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="EnrolmentsIndicator" Width="3" Height="16" CornerRadius="2"
                                Background="Transparent" Margin="0,0,10,0" />
                        <Path Data="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="EnrolmentsNavLabel" Text="Enrolments"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Row="1"
                    Style="{StaticResource NavItemButtonStyle}"
                    Background="{DynamicResource BgSurfaceBrush}"
                    ToolTipService.InitialShowDelay="800"
                    ToolTip="Log Out"
                    Click="OnLogoutClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBlock x:Name="LogoutLabel" Text="Log Out"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Workspace Canvas -->
        <Border Grid.Column="1" Style="{StaticResource WorkspaceCanvasStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Teacher Workspace"
                               Style="{StaticResource TitleTextStyle}"
                               Margin="0,0,0,12" />

                    <Border x:Name="StatusBanner"
                            Style="{StaticResource InfoBarStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="StatusBannerText"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- My Courses Card -->
                    <Border x:Name="MyCoursesCard" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="My Courses"
                                       Style="{StaticResource SectionTextStyle}"
                                       Margin="0,0,0,10" />

                            <DataGrid x:Name="TeacherCoursesGrid"
                                      Style="{StaticResource FluentDataGridStyle}"
                                      SelectionChanged="OnTeacherCourseSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="90" />
                                    <DataGridTextColumn Header="MinToRun" Binding="{Binding MinToRun}" Width="90" />
                                    <DataGridTemplateColumn Header="Status" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999" Padding="10,3" HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource PillBgConverter}}"
                                                        ToolTipService.InitialShowDelay="800"
                                                        ToolTip="Open: below MinToRun · Running: quorum met · Full: at Capacity.">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource PillFgConverter}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Responsive Split: Create Course + Enrolled Students -->
                    <Grid x:Name="BottomSplitGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SplitColLeft" Width="*" />
                            <ColumnDefinition x:Name="SplitColGap" Width="14" />
                            <ColumnDefinition x:Name="SplitColRight" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Create Course Form (NO Credits field) -->
                        <Border x:Name="CreateCourseCard"
                                Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Create Course"
                                               Style="{StaticResource SectionTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Create Course"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTipService.InitialShowDelay="800"
                                            ToolTip="Creates a new course starting with a default of 3 credits. Only an Administrator can edit credits."
                                            Click="OnCreateCourseClick" />
                                </Grid>

                                <TextBlock Text="Code" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                                <TextBox x:Name="CourseCodeBox" Style="{StaticResource FluentTextBoxStyle}" Margin="0,0,0,10" />

                                <TextBlock Text="Title" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                                <TextBox x:Name="CourseTitleBox" Style="{StaticResource FluentTextBoxStyle}" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Capacity" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                                        <TextBox x:Name="CourseCapacityBox"
                                                 Style="{StaticResource FluentTextBoxStyle}"
                                                 ToolTipService.InitialShowDelay="800"
                                                 ToolTip="Maximum number of students permitted to register for this course." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MinToRun" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                                        <TextBox x:Name="CourseMinToRunBox"
                                                 Style="{StaticResource FluentTextBoxStyle}"
                                                 ToolTipService.InitialShowDelay="800"
                                                 ToolTip="Minimum number of registered students required for the course to reach Running (quorum)." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Enrolled Students Card -->
                        <Border x:Name="EnrolmentsCard"
                                Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="EnrolmentsHeadingText"
                                           Text="Enrolled Students"
                                           Style="{StaticResource SectionTextStyle}"
                                           Margin="0,0,0,10" />

                                <DataGrid x:Name="EnrolledStudentsGrid" Style="{StaticResource FluentDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MatricNumber" Binding="{Binding MatricNumber}" Width="110" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="FullName" Binding="{Binding FullName}" Width="1.4*" />
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
