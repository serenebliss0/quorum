<UserControl x:Class="Quorum.UI.Views.StudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Quorum.UI.Services">
    <UserControl.Resources>
        <svc:StatusPillBrushConverter x:Key="PillBgConverter" IsForeground="False" />
        <svc:StatusPillBrushConverter x:Key="PillFgConverter" IsForeground="True" />
    </UserControl.Resources>

    <Grid Margin="0,0,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Grid Grid.Column="0" Margin="12,6,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button x:Name="BrowseNavBtn"
                        Style="{StaticResource NavItemButtonStyle}"
                        Background="{DynamicResource BgSurfaceBrush}"
                        Margin="0,0,0,4"
                        Click="OnSelectBrowseNav">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BrowseIndicator" Width="3" Height="16" CornerRadius="2"
                                Background="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0" />
                        <Path Data="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                              Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.6"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="BrowseNavLabel" Text="Browse Courses"
                                   Style="{StaticResource BodyStrongTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="MyCoursesNavBtn"
                        Style="{StaticResource NavItemButtonStyle}"
                        Click="OnSelectMyCoursesNav">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="MyCoursesIndicator" Width="3" Height="16" CornerRadius="2"
                                Background="Transparent" Margin="0,0,10,0" />
                        <Path Data="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="MyCoursesNavLabel" Text="My Courses"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border x:Name="CreditSummaryCard"
                        Style="{StaticResource CardStyle}"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Credit Load" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="CreditTotalText"
                                   Text="0 / 24 Credits"
                                   Style="{StaticResource SectionTextStyle}"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource NavItemButtonStyle}"
                        Background="{DynamicResource BgSurfaceBrush}"
                        Click="OnLogoutClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBlock x:Name="LogoutLabel" Text="Log Out"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Workspace Canvas -->
        <Border Grid.Column="1" Style="{StaticResource WorkspaceCanvasStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Course Registration"
                               Style="{StaticResource TitleTextStyle}"
                               Margin="0,0,0,12" />

                    <Border x:Name="StatusBanner"
                            Style="{StaticResource InfoBarStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="StatusBannerText"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="MinCreditsWarningBanner"
                            Style="{StaticResource WarningBarStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="MinCreditsWarningText"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource WarningFgBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Available Courses Card -->
                    <Border x:Name="AvailableCoursesCard" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Available Courses"
                                           Style="{StaticResource SectionTextStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Register"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnRegisterClick" />
                            </Grid>

                            <DataGrid x:Name="AvailableCoursesGrid" Style="{StaticResource FluentDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="Credits" Binding="{Binding Credits}" Width="80" />
                                    <DataGridTextColumn Header="Capacity" Binding="{Binding CapacityText}" Width="110" />
                                    <DataGridTemplateColumn Header="Status" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999" Padding="10,3" HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource PillBgConverter}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource PillFgConverter}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- My Courses Card -->
                    <Border x:Name="MyCoursesCard" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="My Courses"
                                           Style="{StaticResource SectionTextStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Drop"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="OnDropClick" />
                            </Grid>

                            <DataGrid x:Name="MyCoursesGrid" Style="{StaticResource FluentDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding CourseCode}" Width="120" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="Credits" Binding="{Binding Credits}" Width="90" />
                                    <DataGridTextColumn Header="RegisteredAt" Binding="{Binding RegisteredAtText}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
