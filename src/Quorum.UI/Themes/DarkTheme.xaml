<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core 5-Token Fluent Dark Palette -->
    <SolidColorBrush x:Key="BgMicaBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#E6252932" />
    <SolidColorBrush x:Key="BgSurfaceSolidBrush" Color="#252932" />
    <SolidColorBrush x:Key="BgCanvasBrush" Color="#B8252932" />
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#2E333E" />
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#363C49" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9FA8B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0F141C" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F364D" />

    <!-- Derived Status & Warning Brushes -->
    <SolidColorBrush x:Key="StatusOpenBgBrush" Color="#1F364D" />
    <SolidColorBrush x:Key="StatusOpenFgBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="StatusRunningBgBrush" Color="#1D3826" />
    <SolidColorBrush x:Key="StatusRunningFgBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="StatusFullBgBrush" Color="#422125" />
    <SolidColorBrush x:Key="StatusFullFgBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#433519" />
    <SolidColorBrush x:Key="WarningFgBrush" Color="#FCE100" />
</ResourceDictionary>
